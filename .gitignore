# --- things that must never be committed ---
# copyrighted ROM dumps and the live, patched cartridge.
# ignore the DIRECTORIES, not just the extensions: `git add -A` happily re-added
# roms/firered.gba and the live cartridge because those files were already tracked.
roms/
integrations/*/rom.gba
integrations/*/rom.sha
integrations/*/type_chart_addr.txt
*.gba
*.sav

# the decompilation: fetched by setup.sh, ~60 MB, not ours to vendor
disasm/

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# the ghost's own memory: personal, rewritten every run, and it changes behaviour - keep it local
soul.json
soul.corrupt.json
.fakechat-soul.json
notebook-*.md

# runtime scratch
*.log
/tmp/
.DS_Store
